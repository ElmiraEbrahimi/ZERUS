# # Environment variables for the Counter Go HTTP API

# # RPC endpoint for the local zkSync L2 (master chain, chain id 271).
# ZKSYNC_RPC_URL=http://localhost:3050

# # Chain ID of the target zkSync L2.
# ZKSYNC_CHAIN_ID=271

# # Private key of the account used by the Go server to sign transactions.
# ZKSYNC_PRIVATE_KEY=0xE90E12261CCb0F3F7976Ae611A29e84a6A85f424

# # Address of the deployed Counter contract (output from the Foundry
# # DeployCounter.s.sol script).
# COUNTER_CONTRACT_ADDRESS=0xYOUR_COUNTER_CONTRACT_ADDRESS_HERE

# # Bind address for the HTTP server.
# HTTP_BIND_ADDR=:18000


ZKSYNC_RPC_URL=http://localhost:3051
ZKSYNC_CHAIN_ID=270   # most likely, for custombase; confirm with cast chain-id
ZKSYNC_PRIVATE_KEY=0x3eb15da85647edd9a1159a4a13b9e7c56877c4eb33f614546d4db06a51868b1c
COUNTER_CONTRACT_ADDRESS=0xdc687e85Fb429194a3cE8c98680cd0454C6176DC
HTTP_BIND_ADDR=:18000
MERKLE_VERIFIER_ADDRESS=0x95dC97A133F577fCFF93CCa8440d3D9aF5F2D5b1
VOTING_BATCH_VERIFIER_ADDRESS=0x83593bC155ec4b695d1552cB7C62f7D455fC9619
