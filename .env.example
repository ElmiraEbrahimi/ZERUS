# Application environment (local, testnet, mainnet)
APP_ENV=local
# HTTP port for the API server
APP_PORT=8080

# PostgreSQL database settings
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable

# Ethereum L1 client configuration
ETH_RPC_URL=http://localhost:8545
ETH_CHAIN_ID=1
ETH_TIMEOUT=10

# zkSync L2 client configuration
ZKSYNC_RPC_URL=http://localhost:3050
ZKSYNC_CHAIN_ID=280
ZKSYNC_TIMEOUT=10