# Environment variables for Foundry / Counter deployment

# Private key of the deployer account used by Foundry scripts. This account
# must be funded on the local zkSync L2 chain. Use one of the rich wallets
# from local-setup/rich-wallets.json.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# RPC endpoint for the local zkSync L2 (master chain, chain id 271).
ZKSYNC_RPC_URL=http://localhost:15100